{
  "name": "vscode-markdown-reference",
  "displayName": "Markdown Reference Preview",
  "description": "Clickable file references and inline source previews for VS Code Markdown preview.",
  "version": "0.0.1",
  "publisher": "r0kuko",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "preview",
    "file reference",
    "code preview"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Markdown Reference Preview",
      "properties": {
        "markdownReference.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 8,
          "maximum": 32,
          "scope": "resource",
          "markdownDescription": "Controls the font size in pixels of file and symbol references in the Markdown preview."
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./node_modules/@vscode/codicons/dist/codicon.css",
      "./media/reference.css"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "markdown-it": "^14.1.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
